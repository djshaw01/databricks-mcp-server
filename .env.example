# Databricks workspace URL (e.g. https://adb-1234567890.12.azuredatabricks.net)
DATABRICKS_HOST=https://<workspace-url>

# Serverless SQL warehouse used for read-only statement execution.
DATABRICKS_WAREHOUSE_ID=<warehouse-id>

# Optional: maximum polling time, in seconds, after the initial 10 second wait.
# Defaults to 120 seconds.
DATABRICKS_SQL_POLL_TIMEOUT_SECONDS=120

# No token needed — authenticate once with the Databricks CLI:
#   brew install databricks
#   databricks auth login --host https://<workspace-url>
# The SDK picks up the OAuth token from ~/.databrickscfg automatically.
