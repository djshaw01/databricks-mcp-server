# Databricks workspace URL (e.g. https://adb-1234567890.12.azuredatabricks.net)
DATABRICKS_HOST=https://<workspace-url>

# Serverless SQL warehouse used for read-only statement execution by query_sql.
# execute_code does not use this warehouse; serverless code execution requires
# Databricks serverless workflows to be enabled in the target workspace.
DATABRICKS_WAREHOUSE_ID=<warehouse-id>

# Optional: maximum polling time, in seconds, after the initial 10 second wait.
# Defaults to 120 seconds when not set.
#DATABRICKS_SQL_POLL_TIMEOUT_SECONDS=120

# Optional: allow execute_code / execute_notebook to read local file_path values
# outside the current working directory. Disabled by default for safer agent use.
#DATABRICKS_MCP_ALLOW_ARBITRARY_LOCAL_FILE_PATHS=1

# No token needed — authenticate once with the Databricks CLI:
#   brew install databricks
#   databricks auth login --host https://<workspace-url>
# The SDK picks up the OAuth token from ~/.databrickscfg automatically.

# Optional named workspace profiles. Tools can pass profile="<name>" to select one.
# Each named profile should also be authenticated with:
#   databricks auth login --host https://<workspace-url> --profile <name>
# The profile name is uppercased and non-alphanumeric characters become underscores
# when resolving .env keys. For example, profile="prod-west" maps to:
#   DATABRICKS_PROFILE_PROD_WEST_HOST
#   DATABRICKS_PROFILE_PROD_WEST_WAREHOUSE_ID
#   Optional: DATABRICKS_PROFILE_PROD_WEST_SQL_POLL_TIMEOUT_SECONDS
#
# DATABRICKS_PROFILE_PROD_WEST_HOST=https://<workspace-url>
# DATABRICKS_PROFILE_PROD_WEST_WAREHOUSE_ID=<warehouse-id>
# Optional: profile-specific polling timeout. Falls back to
# DATABRICKS_SQL_POLL_TIMEOUT_SECONDS, then 120 seconds.
# DATABRICKS_PROFILE_PROD_WEST_SQL_POLL_TIMEOUT_SECONDS=120
